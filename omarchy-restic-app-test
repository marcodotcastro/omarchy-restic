#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CURRENT_USER="${USER:-$(id -un)}"
CURRENT_HOME="${HOME:?HOME não está definido}"
DEFAULT_MOUNT="/media/${CURRENT_USER}/Backup"
DEFAULT_REPOSITORY="${DEFAULT_MOUNT}/omarchy-restic-v2"
REPOSITORY="${OMARCHY_RESTIC_REPOSITORY:-${RESTIC_REPOSITORY:-${DEFAULT_REPOSITORY}}}"
APP_TEST_TAG="omarchy-app-test"
CATALOG_PATH="${SCRIPT_DIR}/omarchy-restic-apps.conf"
SNAPSHOT_ID="latest"
WORKDIR=""
YES=0
KEEP_STAGE=0
PHASE=""
PASSWORD_FILE=""
TEMP_PASSWORD_FILE=""
STAGING_DIR=""
MANIFEST_PATH=""
EXCLUDE_FILE=""
REHEARSAL_DIR=""
REHEARSAL_HOME=""
REHEARSAL_WORKDIR=""
REHEARSAL_TOKEN=""
declare -a BACKUP_PATHS=()
declare -A BACKUP_PATH_SET=()
declare -A MANIFEST_PATH_SET=()
declare -a APP_IDS=()

declare -A APP_NAME=()
declare -A APP_COMMAND=()
declare -A APP_PRESERVE_HOME=()
declare -A APP_INSTALLATION_PATHS=()
declare -A APP_LAUNCHER_PATHS=()
declare -A APP_INSTALLER_PATH=()
declare -A APP_RESTORE_MODE=()

usage() {
  cat <<'USAGE'
Uso:
  omarchy-restic-app-test <fase> [opções]

Fases:
  capture          captura exatamente três aplicativos em um snapshot de teste
  verify-capture   restaura e verifica o snapshot sem alterar o HOME
  rehearse         executa captura, remoção simulada, restore e validação isolados
  assert-removed   confirma a remoção dos artefatos de instalação no ambiente atual
  restore          restaura somente os caminhos de usuário selecionados
  validate         compara o estado restaurado com o manifest capturado

Opções:
  --app ID          aplicativo do catálogo; repetir três vezes em capture
  --catalog PATH    catálogo; padrão: ./omarchy-restic-apps.conf
  --snapshot ID     snapshot de teste; padrão: latest
  --workdir PATH    diretório temporário existente e gravável
  --yes             não pedir confirmação durante restore
  --keep-stage      preservar a área temporária após sucesso
  -h, --help        mostrar esta ajuda
USAGE
}

if (($# == 0)); then
  usage
  exit 0
fi

case "$1" in
  -h|--help)
    usage
    exit 0
    ;;
esac

die() {
  printf '[app-test][erro] %s\n' "$*" >&2
  exit 1
}

log() {
  printf '[app-test] %s\n' "$*"
}

cleanup() {
  local status=$?

  if [[ -n "$TEMP_PASSWORD_FILE" && -f "$TEMP_PASSWORD_FILE" ]]; then
    rm -f -- "$TEMP_PASSWORD_FILE"
  fi

  if [[ -n "$STAGING_DIR" && -d "$STAGING_DIR" ]]; then
    if (( status == 0 && KEEP_STAGE == 0 )); then
      rm -rf -- "$STAGING_DIR"
    else
      printf '[app-test][aviso] staging preservado para diagnóstico: %s\n' "$STAGING_DIR" >&2
    fi
  fi

  if [[ -n "$REHEARSAL_DIR" && -d "$REHEARSAL_DIR" ]]; then
    if (( status == 0 && KEEP_STAGE == 0 )); then
      rm -rf -- "$REHEARSAL_DIR"
    else
      printf '[app-test][aviso] ensaio descartável preservado para diagnóstico: %s\n' "$REHEARSAL_DIR" >&2
    fi
  fi

  exit "$status"
}

restic_cmd() {
  restic -r "$REPOSITORY" "$@"
}

load_password() {
  if [[ -n "${OMARCHY_RESTIC_PASSWORD_FILE:-}" ]]; then
    [[ -r "$OMARCHY_RESTIC_PASSWORD_FILE" ]] || die "arquivo de senha não pode ser lido: $OMARCHY_RESTIC_PASSWORD_FILE"
    PASSWORD_FILE="$OMARCHY_RESTIC_PASSWORD_FILE"
  elif [[ -n "${RESTIC_PASSWORD_FILE:-}" ]]; then
    [[ -r "$RESTIC_PASSWORD_FILE" ]] || die "RESTIC_PASSWORD_FILE não pode ser lido: $RESTIC_PASSWORD_FILE"
    PASSWORD_FILE="$RESTIC_PASSWORD_FILE"
  else
    TEMP_PASSWORD_FILE="$(mktemp "${TMPDIR:-/tmp}/omarchy-restic-app-test-password.XXXXXX")"
    chmod 600 "$TEMP_PASSWORD_FILE"
    printf 'Senha do repositório Restic: ' >&2
    IFS= read -r -s RESTIC_PASSWORD_INPUT || die 'não foi possível ler a senha'
    printf '\n' >&2
    [[ -n "$RESTIC_PASSWORD_INPUT" ]] || die 'a senha não pode ser vazia'
    printf '%s\n' "$RESTIC_PASSWORD_INPUT" >"$TEMP_PASSWORD_FILE"
    unset RESTIC_PASSWORD_INPUT
    PASSWORD_FILE="$TEMP_PASSWORD_FILE"
  fi

  export RESTIC_PASSWORD_FILE="$PASSWORD_FILE"
}

path_is_inside_home() {
  local path="$1"

  [[ "$path" == "$CURRENT_HOME" || "$path" == "$CURRENT_HOME"/* ]]
}

collect_pattern_matches() {
  local path_pattern="$1"
  local expanded
  local -a matches=()
  local -a glob_matches=()

  expanded="$(expand_catalog_path "$path_pattern")"
  if [[ -e "$expanded" || -L "$expanded" ]]; then
    matches+=("$expanded")
  fi

  mapfile -t glob_matches < <(compgen -G "$expanded" || true)
  matches+=("${glob_matches[@]}")

  if ((${#matches[@]} > 0)); then
    printf '%s\n' "${matches[@]}" | sort -u
  fi
}

add_backup_path() {
  local path="$1"

  [[ -e "$path" || -L "$path" ]] || die "caminho não existe no momento da captura: $path"
  if [[ -z "${BACKUP_PATH_SET[$path]+present}" ]]; then
    BACKUP_PATH_SET["$path"]=1
    BACKUP_PATHS+=("$path")
  fi
}

file_metadata() {
  local path="$1"
  local type
  local mode
  local size
  local checksum='-'
  local link_target='-'

  [[ "$path" != *$'\t'* && "$path" != *$'\n'* ]] || die "caminho contém tab ou quebra de linha e não pode entrar no manifest: $path"

  if [[ -L "$path" ]]; then
    type='symlink'
    link_target="$(readlink -- "$path")"
  elif [[ -f "$path" ]]; then
    type='file'
    checksum="$(sha256sum -- "$path" | awk '{print $1}')"
  elif [[ -d "$path" ]]; then
    type='directory'
  else
    die "tipo de arquivo não suportado na captura: $path"
  fi

  mode="$(stat -c '%a' -- "$path")"
  size="$(stat -c '%s' -- "$path")"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$type" "$mode" "$size" "$checksum" "$link_target" "$path" "$CURRENT_HOME" "$PHASE"
}

record_tree() {
  local app_id="$1"
  local role="$2"
  local root_path="$3"
  local path
  local scope
  local metadata
  local type
  local mode
  local size
  local checksum
  local link_target
  local recorded_path

  while IFS= read -r -d '' path; do
    local record_key="${path}|${app_id}|${role}"
    [[ -z "${MANIFEST_PATH_SET[$record_key]+present}" ]] || continue
    MANIFEST_PATH_SET["$record_key"]=1

    if path_is_inside_home "$path"; then
      scope='home'
    else
      scope='system'
    fi

    metadata="$(file_metadata "$path")"
    IFS=$'\t' read -r type mode size checksum link_target recorded_path _ _ <<<"$metadata"
    printf 'path=%s\tapp=%s\trole=%s\tscope=%s\ttype=%s\tmode=%s\tsize=%s\tsha256=%s\tlink_target=%s\n' \
      "$recorded_path" "$app_id" "$role" "$scope" "$type" "$mode" "$size" "$checksum" "$link_target" >>"$MANIFEST_PATH"
  done < <(find -P "$root_path" -print0)
}

record_catalog_paths() {
  local app_id="$1"
  local field_name="$2"
  local role="$3"
  local require_match="$4"
  local path_pattern
  local path
  local -a patterns=()
  local -a matches=()

  IFS=';' read -r -a patterns <<<"$field_name"
  for path_pattern in "${patterns[@]}"; do
    [[ -n "$path_pattern" && "$path_pattern" != none ]] || continue
    [[ "$role" != preserve || "$path_pattern" == \$HOME/* || "$path_pattern" == '~/'* ]] || die "caminho de preserve_home fora do HOME: $path_pattern"
    [[ "$role" != preserve ]] || validate_home_pattern "$path_pattern"
    mapfile -t matches < <(collect_pattern_matches "$path_pattern")
    if (( require_match == 1 && ${#matches[@]} == 0 )); then
      die "caminho necessário não encontrado para $app_id: $path_pattern"
    fi
    for path in "${matches[@]}"; do
      add_backup_path "$path"
      record_tree "$app_id" "$role" "$path"
    done
  done
}

capture_phase() {
  local app_id
  local index=0

  [[ "$EUID" -ne 0 ]] || die 'execute como usuário normal, não como root'
  command -v restic >/dev/null 2>&1 || die 'restic não está instalado'
  command -v awk >/dev/null 2>&1 || die 'awk não está disponível'
  command -v find >/dev/null 2>&1 || die 'find não está disponível'
  command -v sha256sum >/dev/null 2>&1 || die 'sha256sum não está disponível'
  command -v stat >/dev/null 2>&1 || die 'stat não está disponível'
  [[ -d "$REPOSITORY" ]] || die "repositório não encontrado: $REPOSITORY"

  if [[ -n "$WORKDIR" ]]; then
    [[ -d "$WORKDIR" && -w "$WORKDIR" ]] || die "workdir não existe ou não permite escrita: $WORKDIR"
  else
    WORKDIR="${OMARCHY_RESTIC_WORKDIR:-${TMPDIR:-/tmp}}"
    [[ -d "$WORKDIR" && -w "$WORKDIR" ]] || die "workdir não existe ou não permite escrita: $WORKDIR"
  fi

  load_password
  trap cleanup EXIT
  restic_cmd cat config >/dev/null

  STAGING_DIR="$(mktemp -d "$WORKDIR/.omarchy-restic-app-capture.XXXXXX")"
  chmod 700 "$STAGING_DIR"
  MANIFEST_PATH="$STAGING_DIR/omarchy-app-test-manifest.txt"
  EXCLUDE_FILE="$STAGING_DIR/restic-excludes.txt"
  : >"$MANIFEST_PATH"

  {
    printf 'format=omarchy-app-test-v1\n'
    printf 'created_at=%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')"
    printf 'source_home=%s\n' "$CURRENT_HOME"
    printf 'app_count=%s\n' "${#APP_IDS[@]}"
  } >"$MANIFEST_PATH"

  for app_id in "${APP_IDS[@]}"; do
    index=$((index + 1))
    printf 'app.%s.id=%s\n' "$index" "$app_id" >>"$MANIFEST_PATH"
    printf 'app.%s.name=%s\n' "$index" "${APP_NAME[$app_id]}" >>"$MANIFEST_PATH"
    printf 'app.%s.restore_mode=%s\n' "$index" "${APP_RESTORE_MODE[$app_id]}" >>"$MANIFEST_PATH"
    printf 'app.%s.command=%s\n' "$index" "${APP_COMMAND[$app_id]}" >>"$MANIFEST_PATH"

    if [[ -n "${APP_COMMAND[$app_id]}" ]] && command -v pgrep >/dev/null 2>&1; then
      if pgrep -u "$CURRENT_USER" -x "${APP_COMMAND[$app_id]}" >/dev/null 2>&1; then
        die "feche o aplicativo antes da captura: $app_id"
      fi
    fi

    record_catalog_paths "$app_id" "${APP_PRESERVE_HOME[$app_id]}" preserve 1
    record_catalog_paths "$app_id" "${APP_INSTALLATION_PATHS[$app_id]}" installation 1
    record_catalog_paths "$app_id" "${APP_LAUNCHER_PATHS[$app_id]}" launcher 0
    if [[ -n "${APP_INSTALLER_PATH[$app_id]}" && "${APP_INSTALLER_PATH[$app_id]}" != none ]]; then
      record_catalog_paths "$app_id" "${APP_INSTALLER_PATH[$app_id]}" installer 1
    fi
  done

  # O teste de aplicativos precisa preservar exatamente os caminhos
  # selecionados. Exclusões genéricas como node_modules quebram o manifest
  # quando fazem parte da instalação de um aplicativo, como no RubyMine.
  : >"$EXCLUDE_FILE"

  log "criando snapshot com a tag $APP_TEST_TAG"
  restic_cmd backup \
    --one-file-system \
    --exclude-file "$EXCLUDE_FILE" \
    --tag "$APP_TEST_TAG" \
    "${BACKUP_PATHS[@]}" \
    "$STAGING_DIR"

  log 'snapshot de teste criado; listando o snapshot mais recente'
  restic_cmd snapshots --tag "$APP_TEST_TAG" --latest 1
}

ensure_workdir() {
  if [[ -n "$WORKDIR" ]]; then
    [[ -d "$WORKDIR" && -w "$WORKDIR" ]] || die "workdir não existe ou não permite escrita: $WORKDIR"
  else
    WORKDIR="${OMARCHY_RESTIC_WORKDIR:-${TMPDIR:-/tmp}}"
    [[ -d "$WORKDIR" && -w "$WORKDIR" ]] || die "workdir não existe ou não permite escrita: $WORKDIR"
  fi
}

select_snapshot() {
  local snapshot_output

  [[ "$SNAPSHOT_ID" != latest ]] && return 0
  snapshot_output="$(restic_cmd snapshots --tag "$APP_TEST_TAG" --latest 1)" || die "não foi possível localizar um snapshot com a tag $APP_TEST_TAG"
  SNAPSHOT_ID="$(printf '%s\n' "$snapshot_output" | awk '$1 ~ /^[[:xdigit:]]{8,}$/ {print $1; exit}')"
  [[ -n "$SNAPSHOT_ID" ]] || die "nenhum snapshot com a tag $APP_TEST_TAG foi encontrado"
}

restore_snapshot_stage() {
  local manifest_format
  local source_home
  local app_count

  ensure_workdir
  STAGING_DIR="$(mktemp -d "$WORKDIR/.omarchy-restic-app-restore.XXXXXX")"
  chmod 700 "$STAGING_DIR"
  select_snapshot
  log "restaurando e verificando o snapshot $SNAPSHOT_ID"
  restic_cmd restore "$SNAPSHOT_ID" --target "$STAGING_DIR" --verify

  MANIFEST_PATH="$(find "$STAGING_DIR" -type f -name omarchy-app-test-manifest.txt -print -quit 2>/dev/null || true)"
  [[ -n "$MANIFEST_PATH" && -f "$MANIFEST_PATH" ]] || die 'manifest de teste não encontrado no snapshot'
  manifest_format="$(manifest_value format)"
  [[ "$manifest_format" == omarchy-app-test-v1 ]] || die "formato de manifest inválido: $manifest_format"
  source_home="$(manifest_value source_home)"
  [[ -n "$source_home" && "$source_home" == /* ]] || die 'source_home inválido no manifest'
  app_count="$(manifest_value app_count)"
  [[ "$app_count" == 3 ]] || die "manifest deve conter três aplicativos; encontrado: $app_count"
}

manifest_value() {
  local key="$1"

  awk -F= -v wanted="$key" '$1 == wanted {sub(/^[^=]*=/, ""); print; exit}' "$MANIFEST_PATH"
}

map_manifest_path_to_current_home() {
  local path="$1"
  local source_home="$2"

  case "$path" in
    "$source_home"/*)
      printf '%s/%s\n' "$CURRENT_HOME" "${path#"$source_home"/}"
      ;;
    "$source_home")
      printf '%s\n' "$CURRENT_HOME"
      ;;
    *)
      printf '%s\n' "$path"
      ;;
  esac
}

check_manifest_record() {
  local path="$1"
  local expected_type="$2"
  local expected_mode="$3"
  local expected_size="$4"
  local expected_checksum="$5"
  local expected_link_target="$6"
  local actual_mode
  local actual_size
  local actual_checksum
  local actual_link_target

  if [[ "$expected_type" == file ]]; then
    [[ -f "$path" && ! -L "$path" ]] || die "arquivo ausente ou tipo divergente na validação: $path"
    actual_mode="$(stat -c '%a' -- "$path")"
    actual_size="$(stat -c '%s' -- "$path")"
    actual_checksum="$(sha256sum -- "$path" | awk '{print $1}')"
    [[ "$actual_mode" == "$expected_mode" ]] || die "modo divergente na validação: $path"
    [[ "$actual_size" == "$expected_size" ]] || die "tamanho divergente na validação: $path"
    [[ "$actual_checksum" == "$expected_checksum" ]] || die "SHA-256 divergente na validação: $path"
  elif [[ "$expected_type" == directory ]]; then
    [[ -d "$path" && ! -L "$path" ]] || die "diretório ausente ou tipo divergente na validação: $path"
    actual_mode="$(stat -c '%a' -- "$path")"
    [[ "$actual_mode" == "$expected_mode" ]] || die "modo divergente na validação: $path"
  elif [[ "$expected_type" == symlink ]]; then
    [[ -L "$path" ]] || die "symlink ausente ou tipo divergente na validação: $path"
    actual_mode="$(stat -c '%a' -- "$path")"
    actual_link_target="$(readlink -- "$path")"
    [[ "$actual_mode" == "$expected_mode" ]] || die "modo divergente na validação: $path"
    [[ "$actual_link_target" == "$expected_link_target" ]] || die "destino de symlink divergente na validação: $path"
  else
    die "tipo desconhecido no manifest: $expected_type"
  fi
}

verify_manifest_records() {
  local base_path="$1"
  local first_field
  local app_field
  local role_field
  local scope_field
  local type_field
  local mode_field
  local size_field
  local checksum_field
  local link_target_field
  local path
  local target

  while IFS=$'\t' read -r first_field app_field role_field scope_field type_field mode_field size_field checksum_field link_target_field; do
    [[ "$first_field" == path=* ]] || continue
    path="${first_field#path=}"
    target="$base_path/${path#/}"
    check_manifest_record \
      "$target" \
      "${type_field#type=}" \
      "${mode_field#mode=}" \
      "${size_field#size=}" \
      "${checksum_field#sha256=}" \
      "${link_target_field#link_target=}"
  done <"$MANIFEST_PATH"
}

verify_capture_phase() {
  [[ "$EUID" -ne 0 ]] || die 'execute como usuário normal, não como root'
  command -v restic >/dev/null 2>&1 || die 'restic não está instalado'
  command -v find >/dev/null 2>&1 || die 'find não está disponível'
  command -v sha256sum >/dev/null 2>&1 || die 'sha256sum não está disponível'
  command -v stat >/dev/null 2>&1 || die 'stat não está disponível'
  [[ -d "$REPOSITORY" ]] || die "repositório não encontrado: $REPOSITORY"
  load_password
  trap cleanup EXIT
  restore_snapshot_stage
  verify_manifest_records "$STAGING_DIR"
  log 'PASS: captura restaurada e verificada com --verify'
}

assert_removed_phase() {
  local first_field
  local app_field
  local role_field
  local scope_field
  local type_field
  local mode_field
  local size_field
  local checksum_field
  local link_target_field
  local path
  local source_home
  local failures=0
  local app_number
  local app_id
  local command_name
  local command_path

  [[ "$EUID" -ne 0 ]] || die 'execute como usuário normal, não como root'
  command -v restic >/dev/null 2>&1 || die 'restic não está instalado'
  [[ -d "$REPOSITORY" ]] || die "repositório não encontrado: $REPOSITORY"
  load_password
  trap cleanup EXIT
  restore_snapshot_stage
  source_home="$(manifest_value source_home)"

  while IFS=$'\t' read -r first_field app_field role_field scope_field type_field mode_field size_field checksum_field link_target_field; do
    [[ "$first_field" == path=* ]] || continue
    [[ "${role_field#role=}" == installation ]] || continue
    path="${first_field#path=}"
    path="$(map_manifest_path_to_current_home "$path" "$source_home")"
    if [[ -e "$path" || -L "$path" ]]; then
      printf '[app-test][FAIL] artefato de instalação ainda existe: %s\n' "$path" >&2
      failures=$((failures + 1))
    fi
  done <"$MANIFEST_PATH"

  for app_number in 1 2 3; do
    app_id="$(manifest_value "app.${app_number}.id")"
    command_name="$(manifest_value "app.${app_number}.command")"
    if [[ -n "$command_name" ]]; then
      command_path="$(command -v "$command_name" || true)"
      if [[ "${OMARCHY_RESTIC_APP_TEST_SANDBOX:-0}" == 1 ]]; then
        if [[ "$command_path" == "$CURRENT_HOME"/* ]]; then
          printf '[app-test][FAIL] comando de instalação ainda existe para %s: %s\n' "$app_id" "$command_name" >&2
          failures=$((failures + 1))
        fi
      elif [[ -n "$command_path" ]]; then
        printf '[app-test][FAIL] comando de instalação ainda existe para %s: %s\n' "$app_id" "$command_name" >&2
        failures=$((failures + 1))
      fi
    fi
  done

  ((failures == 0)) || die "assert-removed encontrou $failures artefato(s) ainda instalado(s)"
  log 'PASS: artefatos de instalação foram removidos manualmente'
}

assert_rehearsal_sandbox() {
  local marker_path="$CURRENT_HOME/.omarchy-restic-app-test-sandbox"
  local marker_contents

  [[ "${OMARCHY_RESTIC_APP_TEST_SANDBOX:-0}" == 1 ]] || die 'remoção simulada exige o sandbox interno do ensaio'
  [[ -n "${OMARCHY_RESTIC_APP_TEST_SANDBOX_HOME:-}" ]] || die 'sandbox do ensaio não foi identificado'
  [[ -n "${OMARCHY_RESTIC_APP_TEST_SANDBOX_ROOT:-}" ]] || die 'raiz do sandbox do ensaio não foi identificada'
  [[ -n "${OMARCHY_RESTIC_APP_TEST_SANDBOX_TOKEN:-}" ]] || die 'token do sandbox do ensaio não foi identificado'
  [[ "$CURRENT_HOME" == "$OMARCHY_RESTIC_APP_TEST_SANDBOX_HOME" ]] || die 'HOME não corresponde ao sandbox do ensaio'
  [[ "$CURRENT_HOME" == "$OMARCHY_RESTIC_APP_TEST_SANDBOX_ROOT/home" ]] || die 'HOME não é o diretório descartável esperado'
  [[ -d "$OMARCHY_RESTIC_APP_TEST_SANDBOX_ROOT" && ! -L "$OMARCHY_RESTIC_APP_TEST_SANDBOX_ROOT" ]] || die 'raiz do sandbox não é um diretório seguro'
  [[ -d "$CURRENT_HOME" && ! -L "$CURRENT_HOME" ]] || die 'HOME do ensaio não é um diretório seguro'
  [[ -f "$marker_path" && ! -L "$marker_path" ]] || die 'marcador do sandbox não encontrado'
  marker_contents="$(<"$marker_path")"
  [[ "$marker_contents" == "omarchy-restic-app-test sandbox:$OMARCHY_RESTIC_APP_TEST_SANDBOX_TOKEN" ]] || die 'marcador do sandbox não confere'
}

simulate_removal_phase() {
  local source_home
  local first_field
  local app_field
  local role_field
  local scope_field
  local type_field
  local mode_field
  local size_field
  local checksum_field
  local link_target_field
  local path
  local target
  local role
  local scope
  local removed_count=0

  [[ "$EUID" -ne 0 ]] || die 'execute como usuário normal, não como root'
  command -v restic >/dev/null 2>&1 || die 'restic não está instalado'
  [[ -d "$REPOSITORY" ]] || die "repositório não encontrado: $REPOSITORY"
  assert_rehearsal_sandbox
  load_password
  trap cleanup EXIT
  restore_snapshot_stage
  source_home="$(manifest_value source_home)"

  while IFS=$'\t' read -r first_field app_field role_field scope_field type_field mode_field size_field checksum_field link_target_field; do
    [[ "$first_field" == path=* ]] || continue
    role="${role_field#role=}"
    scope="${scope_field#scope=}"
    [[ "$role" == installation || "$role" == launcher ]] || continue
    [[ "$scope" == home ]] || continue

    path="${first_field#path=}"
    target="$(map_manifest_path_to_current_home "$path" "$source_home")"
    [[ "$target" != "$CURRENT_HOME" ]] || die 'remoção simulada recusou o HOME inteiro'
    assert_safe_destination "$target"
    if [[ -e "$target" || -L "$target" ]]; then
      rm -rf -- "$target"
      removed_count=$((removed_count + 1))
    fi
  done <"$MANIFEST_PATH"

  ((removed_count > 0)) || die 'remoção simulada não encontrou artefatos no sandbox'
  log "PASS: remoção simulada isolada concluída ($removed_count artefato(s))"
}

run_rehearsal_child() {
  local child_home="$1"
  local sandbox_flag="$2"
  local phase="$3"
  shift 3

  HOME="$child_home" \
    USER="$CURRENT_USER" \
    OMARCHY_RESTIC_REPOSITORY="$REPOSITORY" \
    OMARCHY_RESTIC_PASSWORD_FILE="$PASSWORD_FILE" \
    RESTIC_PASSWORD_FILE="$PASSWORD_FILE" \
    OMARCHY_RESTIC_APP_TEST_SANDBOX="$sandbox_flag" \
    OMARCHY_RESTIC_APP_TEST_SANDBOX_HOME="$child_home" \
    OMARCHY_RESTIC_APP_TEST_SANDBOX_ROOT="$REHEARSAL_DIR" \
    OMARCHY_RESTIC_APP_TEST_SANDBOX_TOKEN="$REHEARSAL_TOKEN" \
    "$SCRIPT_DIR/omarchy-restic-app-test" "$phase" \
    --catalog "$CATALOG_PATH" \
    --snapshot "$SNAPSHOT_ID" \
    --workdir "$REHEARSAL_WORKDIR" \
    "$@"
}

rehearse_phase() {
  local app_id
  local capture_output
  local -a capture_apps=()

  [[ "$EUID" -ne 0 ]] || die 'execute como usuário normal, não como root'
  command -v restic >/dev/null 2>&1 || die 'restic não está instalado'
  command -v rsync >/dev/null 2>&1 || die 'rsync não está instalado'
  [[ -d "$REPOSITORY" ]] || die "repositório não encontrado: $REPOSITORY"
  validate_selected_apps
  ensure_workdir
  load_password
  trap cleanup EXIT
  restic_cmd cat config >/dev/null

  REHEARSAL_DIR="$(mktemp -d "$WORKDIR/.omarchy-restic-app-rehearsal.XXXXXX")"
  chmod 700 "$REHEARSAL_DIR"
  REHEARSAL_TOKEN="$(basename -- "$REHEARSAL_DIR")"
  REHEARSAL_HOME="$REHEARSAL_DIR/home"
  REHEARSAL_WORKDIR="$REHEARSAL_DIR/workdir"
  mkdir -m 700 "$REHEARSAL_HOME" "$REHEARSAL_WORKDIR"

  for app_id in "${APP_IDS[@]}"; do
    capture_apps+=(--app "$app_id")
  done

  log 'fase 1/6: capturando os aplicativos selecionados'
  capture_output="$REHEARSAL_DIR/capture-output.txt"
  run_rehearsal_child "$CURRENT_HOME" 0 capture "${capture_apps[@]}" >"$capture_output" 2>&1
  cat "$capture_output"
  SNAPSHOT_ID="$(awk '$1 == "snapshot" && $3 == "saved" {print $2; exit}' "$capture_output")"
  [[ -n "$SNAPSHOT_ID" ]] || die 'não foi possível identificar o snapshot recém-criado'
  log 'fase 2/6: verificando a captura com restore --verify'
  run_rehearsal_child "$CURRENT_HOME" 0 verify-capture
  log 'fase 3/6: restaurando a captura para um HOME descartável'
  run_rehearsal_child "$REHEARSAL_HOME" 1 restore --yes

  printf 'omarchy-restic-app-test sandbox:%s\n' "$REHEARSAL_TOKEN" >"$REHEARSAL_HOME/.omarchy-restic-app-test-sandbox"
  chmod 600 "$REHEARSAL_HOME/.omarchy-restic-app-test-sandbox"

  log 'fase 4/6: removendo somente os artefatos dentro do sandbox'
  run_rehearsal_child "$REHEARSAL_HOME" 1 simulate-removal
  log 'fase 5/6: confirmando a remoção simulada'
  run_rehearsal_child "$REHEARSAL_HOME" 1 assert-removed
  log 'fase 6/6: restaurando e validando o HOME descartável'
  run_rehearsal_child "$REHEARSAL_HOME" 1 restore --yes
  run_rehearsal_child "$REHEARSAL_HOME" 1 validate

  log 'PASS: ensaio descartável completo; o HOME real não foi alterado'
}

ask_yes_no() {
  local prompt="$1"
  local answer

  if (( YES == 1 )); then
    return 0
  fi

  printf '%s [s/N] ' "$prompt" >&2
  IFS= read -r answer || return 1
  [[ "$answer" =~ ^[sS](i|I)?(m|M)?$ || "$answer" =~ ^[yY]$ ]]
}

assert_safe_destination() {
  local destination="$1"
  local cursor

  case "$destination" in
    "$CURRENT_HOME"|"$CURRENT_HOME"/*)
      ;;
    *)
      die "destino de restore fora do HOME: $destination"
      ;;
  esac

  cursor="$destination"
  if [[ ! -d "$cursor" || -L "$cursor" ]]; then
    cursor="${cursor%/*}"
  fi
  while [[ "$cursor" != "$CURRENT_HOME" && "$cursor" == "$CURRENT_HOME"/* ]]; do
    [[ ! -L "$cursor" ]] || die "destino contém symlink e foi recusado por segurança: $cursor"
    cursor="${cursor%/*}"
  done
}

is_under_restored_root() {
  local path="$1"
  local root

  for root in "${RESTORE_ROOTS[@]}"; do
    [[ "$path" == "$root" || "$path" == "$root"/* ]] && return 0
  done
  return 1
}

restore_home_records() {
  local source_home="$1"
  local first_field
  local app_field
  local role_field
  local scope_field
  local type_field
  local mode_field
  local size_field
  local checksum_field
  local link_target_field
  local path
  local relative_path
  local source_path
  local destination_path
  local destination_parent
  local scope
  local type
  local key
  local staged_count=0
  declare -a RESTORE_ROOTS=()
  declare -A RESTORE_PATH_SET=()

  PRE_RESTORE_DIR="$CURRENT_HOME/.omarchy-restic-app-test-pre-restore-$(date '+%Y%m%d-%H%M%S')-$$"
  mkdir -m 700 "$PRE_RESTORE_DIR"

  while IFS=$'\t' read -r first_field app_field role_field scope_field type_field mode_field size_field checksum_field link_target_field; do
    [[ "$first_field" == path=* ]] || continue
    path="${first_field#path=}"
    scope="${scope_field#scope=}"
    type="${type_field#type=}"

    if [[ "$scope" != home ]]; then
      staged_count=$((staged_count + 1))
      continue
    fi

    case "$path" in
      "$source_home"/*)
        relative_path="${path#"$source_home"/}"
        ;;
      *)
        die "caminho de manifest não pertence ao source_home: $path"
        ;;
    esac

    destination_path="$CURRENT_HOME/$relative_path"
    key="$destination_path"
    [[ -z "${RESTORE_PATH_SET[$key]+present}" ]] || continue
    RESTORE_PATH_SET["$key"]=1
    if is_under_restored_root "$path"; then
      continue
    fi

    source_path="$STAGING_DIR/${path#/}"
    [[ -e "$source_path" || -L "$source_path" ]] || die "origem do restore não encontrada: $source_path"
    assert_safe_destination "$destination_path"

    if [[ "$type" == directory ]]; then
      mkdir -p -- "$destination_path"
      rsync -a --backup --backup-dir="$PRE_RESTORE_DIR" "$source_path/" "$destination_path/"
      RESTORE_ROOTS+=("$path")
    else
      destination_parent="${destination_path%/*}"
      mkdir -p -- "$destination_parent"
      rsync -a --backup --backup-dir="$PRE_RESTORE_DIR" "$source_path" "$destination_path"
    fi
  done <"$MANIFEST_PATH"

  if (( staged_count > 0 )); then
    log "STAGED ONLY: $staged_count registro(s) de sistema permanecem na área temporária"
  fi
}

restore_phase() {
  local source_home

  [[ "$EUID" -ne 0 ]] || die 'execute como usuário normal, não como root'
  command -v restic >/dev/null 2>&1 || die 'restic não está instalado'
  command -v rsync >/dev/null 2>&1 || die 'rsync não está instalado'
  command -v find >/dev/null 2>&1 || die 'find não está disponível'
  [[ -d "$REPOSITORY" ]] || die "repositório não encontrado: $REPOSITORY"
  load_password
  trap cleanup EXIT
  restore_snapshot_stage
  source_home="$(manifest_value source_home)"

  printf 'O restore copiará apenas caminhos de usuário dos três aplicativos.\n'
  printf 'Arquivos sobrescritos serão preservados em .omarchy-restic-app-test-pre-restore-*.\n'
  ask_yes_no 'Continuar com o restore dos aplicativos?' || die 'restore cancelado pelo usuário'
  restore_home_records "$source_home"
  log 'PASS: caminhos de usuário restaurados'
}

validate_live_phase() {
  local source_home
  local first_field
  local app_field
  local role_field
  local scope_field
  local type_field
  local mode_field
  local size_field
  local checksum_field
  local link_target_field
  local path
  local relative_path
  local destination_path
  local scope
  local type
  local staged_count=0

  [[ "$EUID" -ne 0 ]] || die 'execute como usuário normal, não como root'
  command -v restic >/dev/null 2>&1 || die 'restic não está instalado'
  command -v sha256sum >/dev/null 2>&1 || die 'sha256sum não está disponível'
  command -v stat >/dev/null 2>&1 || die 'stat não está disponível'
  [[ -d "$REPOSITORY" ]] || die "repositório não encontrado: $REPOSITORY"
  load_password
  trap cleanup EXIT
  restore_snapshot_stage
  source_home="$(manifest_value source_home)"

  while IFS=$'\t' read -r first_field app_field role_field scope_field type_field mode_field size_field checksum_field link_target_field; do
    [[ "$first_field" == path=* ]] || continue
    scope="${scope_field#scope=}"
    if [[ "$scope" != home ]]; then
      staged_count=$((staged_count + 1))
      continue
    fi

    path="${first_field#path=}"
    case "$path" in
      "$source_home"/*)
        relative_path="${path#"$source_home"/}"
        ;;
      *)
        die "caminho de manifest não pertence ao source_home: $path"
        ;;
    esac
    destination_path="$CURRENT_HOME/$relative_path"
    type="${type_field#type=}"
    check_manifest_record \
      "$destination_path" \
      "$type" \
      "${mode_field#mode=}" \
      "${size_field#size=}" \
      "${checksum_field#sha256=}" \
      "${link_target_field#link_target=}"
  done <"$MANIFEST_PATH"

  if (( staged_count > 0 )); then
    log "STAGED ONLY: $staged_count registro(s) de sistema não foram validados no sistema ativo"
  fi
  log 'PASS: hashes, tipos e permissões dos caminhos de usuário conferem'
}

catalog_load() {
  local line
  local -a fields
  local id
  local name
  local command_name
  local preserve_home
  local installation_paths
  local launcher_paths
  local installer_path
  local restore_mode

  [[ -f "$CATALOG_PATH" ]] || die "catálogo não encontrado: $CATALOG_PATH"

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue

    IFS='|' read -r -a fields <<<"$line"
    ((${#fields[@]} == 8)) || die "linha inválida no catálogo (esperados 8 campos): $line"

    id="${fields[0]}"
    name="${fields[1]}"
    command_name="${fields[2]}"
    preserve_home="${fields[3]}"
    installation_paths="${fields[4]}"
    launcher_paths="${fields[5]}"
    installer_path="${fields[6]}"
    restore_mode="${fields[7]}"

    [[ -n "$id" ]] || die 'ID vazio no catálogo'
    [[ "$id" != *[[:space:]]* && "$id" != *'|'* ]] || die "ID inválido no catálogo: $id"
    [[ -z "${APP_NAME[$id]+present}" ]] || die "ID duplicado no catálogo: $id"
    [[ "$restore_mode" == home || "$restore_mode" == staged ]] || die "restore_mode inválido para $id: $restore_mode"
    if [[ "$restore_mode" == home ]]; then
      validate_home_installation_paths "$id" "$installation_paths"
    fi

    APP_NAME["$id"]="$name"
    APP_COMMAND["$id"]="$command_name"
    APP_PRESERVE_HOME["$id"]="$preserve_home"
    APP_INSTALLATION_PATHS["$id"]="$installation_paths"
    APP_LAUNCHER_PATHS["$id"]="$launcher_paths"
    APP_INSTALLER_PATH["$id"]="$installer_path"
    APP_RESTORE_MODE["$id"]="$restore_mode"
  done <"$CATALOG_PATH"
}

catalog_require_app() {
  local app_id="$1"

  [[ -n "${APP_NAME[$app_id]+present}" ]] || die "aplicativo não encontrado no catálogo: $app_id"
}

validate_home_installation_paths() {
  local app_id="$1"
  local installation_paths="$2"
  local path_pattern

  while IFS= read -r path_pattern; do
    [[ -n "$path_pattern" && "$path_pattern" != none ]] || continue
    case "$path_pattern" in
      \$HOME/*|~/*)
        ;;
      *)
        die "restore_mode=home exige caminhos de instalação dentro do HOME para $app_id: $path_pattern"
        ;;
    esac
  done < <(printf '%s\n' "$installation_paths" | tr ';' '\n')
}

expand_catalog_path() {
  local path_pattern="$1"

  case "$path_pattern" in
    \$HOME/*)
      printf '%s%s\n' "$CURRENT_HOME" "${path_pattern#\$HOME}"
      ;;
    '~/'*)
      printf '%s/%s\n' "$CURRENT_HOME" "${path_pattern#'~/'}"
      ;;
    /*)
      printf '%s\n' "$path_pattern"
      ;;
    *)
      die "caminho do catálogo deve começar com \$HOME/, ~/, ou /: $path_pattern"
      ;;
  esac
}

validate_home_pattern() {
  local path_pattern="$1"
  local expanded

  expanded="$(expand_catalog_path "$path_pattern")"
  case "$expanded" in
    "$CURRENT_HOME"|"$CURRENT_HOME"/*)
      ;;
    *)
      die "caminho de preserve_home fora do HOME: $path_pattern"
      ;;
  esac

  [[ "$expanded" != *'/../'* && "$expanded" != */.. ]] || die "caminho de preserve_home fora do HOME: $path_pattern"
}

validate_selected_apps() {
  local app_id
  local preserve_pattern

  ((${#APP_IDS[@]} == 3)) || die 'capture exige exatamente três aplicativos'

  for app_id in "${APP_IDS[@]}"; do
    catalog_require_app "$app_id"
  done

  [[ "${APP_IDS[0]}" != "${APP_IDS[1]}" && "${APP_IDS[0]}" != "${APP_IDS[2]}" && "${APP_IDS[1]}" != "${APP_IDS[2]}" ]] || die 'IDs de aplicativos duplicados na seleção'

  for app_id in "${APP_IDS[@]}"; do
    while IFS= read -r preserve_pattern; do
      [[ -n "$preserve_pattern" ]] || continue
      validate_home_pattern "$preserve_pattern"
    done < <(printf '%s\n' "${APP_PRESERVE_HOME[$app_id]}" | tr ';' '\n')
  done
}

parse_arguments() {
  PHASE="$1"
  shift

  while (($# > 0)); do
    case "$1" in
      --app)
        shift
        (($# > 0)) || die '--app precisa de um ID'
        APP_IDS+=("$1")
        ;;
      --catalog)
        shift
        (($# > 0)) || die '--catalog precisa de um caminho'
        CATALOG_PATH="$1"
        ;;
      --snapshot)
        shift
        (($# > 0)) || die '--snapshot precisa de um ID'
        SNAPSHOT_ID="$1"
        ;;
      --workdir)
        shift
        (($# > 0)) || die '--workdir precisa de um caminho'
        WORKDIR="$1"
        ;;
      --yes)
        YES=1
        ;;
      --keep-stage)
        KEEP_STAGE=1
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "opção desconhecida: $1 (use --help)"
        ;;
    esac
    shift
  done
}

[[ "$1" == capture || "$1" == verify-capture || "$1" == rehearse || "$1" == simulate-removal || "$1" == assert-removed || "$1" == restore || "$1" == validate ]] || die "fase desconhecida: $1"
parse_arguments "$@"

catalog_load
if [[ "$PHASE" == capture ]]; then
  validate_selected_apps
  capture_phase
  exit 0
fi

if [[ "$PHASE" == verify-capture ]]; then
  verify_capture_phase
  exit 0
fi

if [[ "$PHASE" == rehearse ]]; then
  rehearse_phase
  exit 0
fi

if [[ "$PHASE" == simulate-removal ]]; then
  simulate_removal_phase
  exit 0
fi

if [[ "$PHASE" == assert-removed ]]; then
  assert_removed_phase
  exit 0
fi

if [[ "$PHASE" == restore ]]; then
  restore_phase
  exit 0
fi

if [[ "$PHASE" == validate ]]; then
  validate_live_phase
  exit 0
fi

printf '[app-test][erro] fase ainda não implementada: %s\n' "$PHASE" >&2
exit 2
